{
  "name": "postman-api-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "demo": "node demo/server.ts",
    "test": "node scripts/run.ts",
    "test:unit": "node --test --test-timeout=10000 tests/*.test.ts",
    "verify": "npm run check && npm run test:unit && npm test"
  },
  "devDependencies": {
    "postman-cli": "1.74.0",
    "typescript": "5.9.3",
    "@types/node": "24.19.2"
  }
}
